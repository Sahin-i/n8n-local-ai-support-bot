    {
      "parameters": {
        "jsCode": "const original = $('Normalize input').first().json;\n\nconst raw = $json?.message?.content ?? '';\n\nconst allowedCategories = [\n  'billing',\n  'technical',\n  'general'\n];\n\nconst allowedActions = [\n  'none',\n  'weather'\n];\n\nlet aiCategory = null;\nlet category = 'unrecognized';\nlet confidence = 0;\nlet action = 'none';\nlet aiOk = false;\n\ntry {\n  const parsed =\n    typeof raw === 'string'\n      ? JSON.parse(raw)\n      : raw;\n\n  if (allowedCategories.includes(parsed.category)) {\n    aiCategory = parsed.category;\n  }\n\n  if (Number.isFinite(Number(parsed.confidence))) {\n    confidence = Number(parsed.confidence);\n  }\n\n  if (allowedActions.includes(parsed.action)) {\n    action = parsed.action;\n  }\n\n  if (\n    aiCategory !== null &&\n    confidence >= 0.60\n  ) {\n    category = aiCategory;\n    aiOk = true;\n  }\n\n} catch (error) {\n  category = 'unrecognized';\n  confidence = 0;\n  aiOk = false;\n}\n\nreturn [\n  {\n    json: {\n      ...original,\n      category,\n      ai_category: aiCategory,\n      confidence,\n      action,\n      ai_ok: aiOk,\n      ai_raw: raw\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
